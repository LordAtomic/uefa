<html lang="en"><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Prime TV • Sayan 2026</title>
  <script src="https://cdn.jsdelivr.net/npm/shaka-player@4.16.2/dist/shaka-player.ui.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/shaka-player@4.16.2/dist/controls.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    html,body{width:100%;height:100%;background:#000;overflow:hidden;font-family:system-ui,-apple-system,sans-serif}
    .shaka-video-container{position:fixed;inset:0;background:#000;display:flex;align-items:center;justify-content:center}
    video{width:100%;height:100%;object-fit:contain;background:#000}
    .shaka-spinner-container{display:none!important}
    #wm{
      position:absolute;bottom:70px;left:50%;transform:translateX(-50%);
      z-index:2147483647;pointer-events:none;user-select:none;
      display:flex;align-items:center;gap:8px;
      opacity:.55;transition:opacity .5s
    }
    .wm-rule{width:18px;height:1px;background:linear-gradient(90deg,transparent,rgba(232,0,29,.9))}
    .wm-rule.r{background:linear-gradient(90deg,rgba(232,0,29,.9),transparent)}
    .wm-inner{display:flex;flex-direction:column;align-items:center;gap:1px}
    .wm-name{font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:4px;line-height:1;color:#fff;white-space:nowrap;text-shadow:0 1px 8px #000,0 0 24px rgba(0,0,0,.9)}
    .wm-name .r{color:#e8001d}
    .wm-url{font-family:'Rajdhani',sans-serif;font-size:9px;font-weight:600;letter-spacing:3px;color:rgba(255,255,255,.7);white-space:nowrap;text-shadow:0 1px 6px rgba(0,0,0,.9);text-transform:uppercase}
  </style>
</head>
<body>
  <div class="shaka-video-container" id="player-container">
    <video id="video" autoplay playsinline></video>
    <div id="wm">
      <div class="wm-rule"></div>
      <div class="wm-inner">
        <div class="wm-name">HELLO<span class="r">SPORTS</span></div>
        <div class="wm-url">hellosports.live</div>
      </div>
      <div class="wm-rule r"></div>
    </div>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', async () => {
      shaka.polyfill.installAll();
      if (!shaka.Player.isBrowserSupported()) return;

      const videoEl = document.getElementById('video');
      const container = document.getElementById('player-container');
      const wm = document.getElementById('wm');

      const streamUrl = "https://tvsen5.aynascope.net/cXPB2LKkErN9/index.m3u8?e=1774796641&u=78be6644-0a65-48ec-81a4-089ac65a2619&token=a2b71d36bbf93004a8ed58a02e74f5d9"; // <-- paste your .m3u8 URL here

      const player = new shaka.Player();
      await player.attach(videoEl);
      const ui = new shaka.ui.Overlay(player, container, videoEl);

      ui.configure({
        controlPanelElements: ['play_pause','mute','volume','time_and_duration','spacer','language','captions','picture_in_picture','quality','fullscreen'],
        seekBarColors: { base:'white', buffered:'red', played:'green' }
      });

      // inject watermark after UI builds
      setTimeout(() => container.appendChild(wm), 100);

      player.configure({

        // ── ABR (Adaptive Bitrate) - smooth quality switching ──
        abr: {
          enabled: true,
          defaultBandwidthEstimate: 1500000,    // start assuming 1.5 Mbps
          switchInterval: 3,                     // don't switch quality too fast (avoid flicker)
          bandwidthUpgradeTarget: 0.85,          // upgrade when 85% bandwidth available
          bandwidthDowngradeTarget: 0.95,        // downgrade only when really needed
          restrictions: {
            minBandwidth: 0,
            maxBandwidth: Infinity
          }
        },

        // ── Manifest config ──
        manifest: {
          defaultPresentationDelay: 6,
          retryParameters: {
            maxAttempts: 8,
            baseDelay: 500,
            backoffFactor: 1.5,
            timeout: 30000,
            stallTimeout: 5000,
            connectionTimeout: 10000,
            fuzzFactor: 0.5
          },
          hls: {
            ignoreManifestProgramDateTime: false,
            useFullSegmentsForStartTime: true,
            ignoreTextStreamFailures: true
          },
          availabilityWindowOverride: 120
        },

        // ── Streaming - big buffers, smooth playback ──
        streaming: {
          bufferingGoal: 30,                     // buffer 30s ahead
          rebufferingGoal: 2,                    // resume quickly after stall (2s buffer)
          bufferBehind: 30,                      // keep 30s behind for rewind
          stallEnabled: true,
          stallThreshold: 1,
          stallSkip: 0.1,                        // skip 100ms on stall to recover
          jumpLargeGaps: true,                   // auto-skip gaps in stream
          smallGapLimit: 2,                      // treat gaps under 2s as small
          gapDetectionThreshold: 0.5,
          durationBackoff: 1,
          safeSeekOffset: 5,
          lowLatencyMode: false,                 // OFF for smoother playback
          autoLowLatencyMode: false,
          forceHTTPS: false,
          preferNativeHls: false,
          startAtSegmentBoundary: true,
          ignoreTextStreamFailures: true,
          retryParameters: {
            maxAttempts: 8,
            baseDelay: 500,
            backoffFactor: 1.5,
            timeout: 30000,
            stallTimeout: 5000,
            connectionTimeout: 10000,
            fuzzFactor: 0.5
          },
          failureCallback: (error) => {
            // auto-retry on streaming failure
            player.retryStreaming();
          }
        },

        // ── Networking - retry aggressively ──
        networking: {
          retryParameters: {
            maxAttempts: 6,
            baseDelay: 500,
            backoffFactor: 2,
            timeout: 20000,
            stallTimeout: 5000,
            connectionTimeout: 10000,
            fuzzFactor: 0.5
          }
        }
      });

      // ── Network filters - add cache busting for live manifests ──
      player.getNetworkingEngine().registerRequestFilter((type, request) => {
        if (type === shaka.net.NetworkingEngine.RequestType.MANIFEST) {
          // Prevent stale cached manifests for live
          if (request.uris && request.uris.length > 0) {
            request.uris = request.uris.map(uri => {
              const sep = uri.includes('?') ? '&' : '?';
              return uri + sep + '_t=' + Date.now();
            });
          }
        }
      });

      // ── Error handling with auto-recovery ──
      let retryCount = 0;
      const maxRetries = 10;

      player.addEventListener('error', (event) => {
        const error = event.detail;
        console.warn('Shaka error:', error.code, error.message);

        if (retryCount < maxRetries) {
          retryCount++;
          const delay = Math.min(1000 * retryCount, 5000);
          console.log(`Retry ${retryCount}/${maxRetries} in ${delay}ms...`);
          setTimeout(async () => {
            try {
              await player.load(streamUrl, null, 'application/x-mpegURL');
              videoEl.play();
              retryCount = 0; // reset on success
            } catch (e) {
              console.warn('Retry failed:', e);
            }
          }, delay);
        }
      });

      // ── Stall detection & recovery ──
      let lastTime = 0;
      let stallCount = 0;
      setInterval(() => {
        if (!videoEl.paused && !videoEl.seeking) {
          if (Math.abs(videoEl.currentTime - lastTime) < 0.1) {
            stallCount++;
            if (stallCount >= 3) {
              // Stuck for ~3 seconds, nudge forward
              console.log('Stall detected, nudging...');
              videoEl.currentTime += 0.5;
              stallCount = 0;
            }
          } else {
            stallCount = 0;
          }
          lastTime = videoEl.currentTime;
        }
      }, 1000);

      // ── Live edge sync (for live streams) ──
      setInterval(() => {
        if (!videoEl.paused && player.isLive()) {
          const seekRange = player.seekRange();
          const liveEdge = seekRange.end;
          const behind = liveEdge - videoEl.currentTime;
          // If more than 30s behind live edge, jump closer
          if (behind > 30) {
            console.log(`${behind.toFixed(0)}s behind live, syncing...`);
            videoEl.currentTime = liveEdge - 5;
          }
        }
      }, 10000);

      // ── Load & play ──
      try {
        await player.load(streamUrl, null, 'application/x-mpegURL');
        videoEl.play();
      } catch(e) {
        console.warn('Initial load failed, retrying in 2s...');
        setTimeout(async () => {
          try {
            await player.load(streamUrl, null, 'application/x-mpegURL');
            videoEl.play();
          } catch(e2) {}
        }, 2000);
      }

      // ── Fullscreen watermark fix ──
      const onFsChange = () => {
        const fsEl = document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement;
        if(fsEl){ fsEl.appendChild(wm); wm.style.opacity='.50'; }
        else{ container.appendChild(wm); wm.style.opacity='.55'; }
      };
      document.addEventListener('fullscreenchange', onFsChange);
      document.addEventListener('webkitfullscreenchange', onFsChange);
      document.addEventListener('mozfullscreenchange', onFsChange);

      // ── Watermark fade ──
      videoEl.addEventListener('play', () => setTimeout(()=>{ wm.style.opacity='.30'; }, 3000));
      videoEl.addEventListener('pause', () => { wm.style.opacity='.55'; });
      document.addEventListener('mousemove', () => {
        wm.style.opacity='.55';
        clearTimeout(window._wmTimer);
        window._wmTimer = setTimeout(()=>{ if(!videoEl.paused) wm.style.opacity='.30'; }, 3000);
      });
      document.addEventListener('touchstart', () => {
        wm.style.opacity='.55';
        clearTimeout(window._wmTimer);
        window._wmTimer = setTimeout(()=>{ if(!videoEl.paused) wm.style.opacity='.30'; }, 3000);
      });
    });
